# OpenAI Compatible endpoint
# Use the `/v1` base URL, not `/v1/chat/completions`.
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1

# Optional. Leave empty for local servers that do not require auth.
OPENAI_COMPATIBLE_API_KEY=

# Must match the model id the server exposes (`GET /v1/models`).
OPENAI_COMPATIBLE_MODEL=llama3.2

# Optional prefix for model strings. Agents use `"<id>/<model>"`.
OPENAI_COMPATIBLE_ID=custom
OPENAI_COMPATIBLE_NAME=OpenAI Compatible
